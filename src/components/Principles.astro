---
import { getLangFromUrl, useTranslations } from '../i18n/utils'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

// Tools that actually run in this repository's workflow.
const qualityTools = ['Biome', 'TypeScript strict', 'Vitest', 'Playwright']
---

<section id="principles" class="border-t border-line" aria-labelledby="principles-heading">
	<div class="mx-auto max-w-[1440px] px-4 py-24 md:px-8 md:py-32">
		<h2 id="principles-heading" class="display text-[clamp(3rem,6vw,5.5rem)]" data-reveal>
			{t('principles.title')}
		</h2>

		<div class="mt-14 grid grid-cols-1 gap-3 md:grid-cols-12">
			<!-- Lead principle: the accent tile -->
			<article
				class="flex min-h-[22rem] flex-col justify-between bg-accent p-6 text-on-accent md:col-span-7 md:row-span-2 md:p-10"
				data-reveal
			>
				<p class="display text-[clamp(5rem,12vw,10rem)] leading-[0.8]" aria-hidden="true">S.O.L.I.D</p>
				<div>
					<h3 class="display text-[clamp(2rem,3.6vw,3.25rem)]">{t('principles.p1.title')}</h3>
					<p class="mt-4 max-w-[44ch] text-lg leading-snug">{t('principles.p1.body')}</p>
				</div>
			</article>

			<article class="flex flex-col justify-between gap-10 bg-raised p-6 md:col-span-5 md:p-8" data-reveal style="--d: 1">
				<h3 class="display text-[clamp(1.75rem,2.6vw,2.5rem)]">{t('principles.p2.title')}</h3>
				<p class="max-w-[40ch] leading-relaxed text-ink-muted">{t('principles.p2.body')}</p>
			</article>

			<article
				class="flex flex-col justify-between gap-10 border border-line p-6 md:col-span-5 md:p-8"
				data-reveal
				style="--d: 2"
			>
				<h3 class="display text-[clamp(1.75rem,2.6vw,2.5rem)]">{t('principles.p3.title')}</h3>
				<p class="max-w-[40ch] leading-relaxed text-ink-muted">{t('principles.p3.body')}</p>
			</article>

			<!-- Quality gate: inverted tile with the real toolchain -->
			<article
				class="grid grid-cols-1 gap-8 bg-ink p-6 text-paper md:col-span-12 md:grid-cols-12 md:p-10"
				data-reveal
				style="--d: 3"
			>
				<div class="md:col-span-5">
					<h3 class="display text-[clamp(1.75rem,2.6vw,2.5rem)]">{t('principles.quality.title')}</h3>
					<p class="mt-4 max-w-[40ch] leading-relaxed opacity-75">{t('principles.quality.body')}</p>
				</div>
				<ul class="grid grid-cols-2 gap-px self-end md:col-span-7">
					{
						qualityTools.map((tool) => (
							<li class="border-t border-paper/20 pt-3 font-mono text-[clamp(1rem,1.6vw,1.35rem)]">
								{tool}
							</li>
						))
					}
				</ul>
			</article>
		</div>
	</div>
</section>
