---
import { getLangFromUrl, useTranslations } from '../i18n/utils'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

const email = 'jejorm8@gmail.com'
const fieldClass =
	'mt-2 w-full border border-ink-muted bg-transparent px-4 py-3.5 text-body text-ink placeholder:text-ink-muted transition-colors hover:border-ink focus:border-ink aria-[invalid=true]:border-accent'
---

<section id="contact" class="border-t border-line" aria-labelledby="contact-heading">
	<div class="mx-auto max-w-[1440px] px-4 py-24 md:px-8 md:py-32">
		<h2
			id="contact-heading"
			class="display type-settle text-poster leading-[0.86]"
			data-reveal
		>
			{t('contact.title')}
		</h2>

		<div class="mt-16 grid grid-cols-1 gap-16 lg:grid-cols-12 lg:gap-8">
			<div class="lg:col-span-5">
				<p class="max-w-[36ch] text-lead text-ink-muted" data-reveal>{t('contact.intro')}</p>

				<div class="mt-10" data-reveal style="--d: 1">
					<p class="meta text-ink-muted">{t('contact.email.label')}</p>
					<a
						href={`mailto:${email}`}
						class="link-line mt-2 inline-block text-title font-medium tracking-tight break-all"
					>
						{email}
					</a>
					<div class="mt-4">
						<button
							type="button"
							data-copy-email
							class="meta border border-line px-3 py-1.5 uppercase transition-colors hover:border-ink active:scale-[0.98]"
							data-email={email}
							data-copied={t('contact.copied')}
						>
							{t('contact.copy')}
						</button>
					</div>
				</div>

				<ul class="mt-12 flex gap-8 text-body" data-reveal style="--d: 2">
					<li>
						<a
							class="link-line inline-flex items-center gap-2"
							href="https://github.com/Jejorm"
							target="_blank"
							rel="noopener noreferrer"
						>
							GitHub <span class="arrow-nudge" aria-hidden="true">↗</span>
						</a>
					</li>
					<li>
						<a
							class="link-line inline-flex items-center gap-2"
							href="https://www.linkedin.com/in/jeremy-orellana-76224023a/"
							target="_blank"
							rel="noopener noreferrer"
						>
							LinkedIn <span class="arrow-nudge" aria-hidden="true">↗</span>
						</a>
					</li>
				</ul>
			</div>

			<form
				id="contact-form"
				class="space-y-7 lg:col-span-6 lg:col-start-7"
				action="https://formspree.io/f/meepgbyp"
				method="POST"
				novalidate
				data-reveal
				data-msg-required={t('contact.form.required')}
				data-msg-email={t('contact.form.invalidEmail')}
				data-msg-sending={t('contact.form.sending')}
				data-msg-success={t('contact.form.success')}
				data-msg-error={t('contact.form.error')}
			>
				<div>
					<label class="text-ui font-medium" for="contact-name">{t('contact.form.name')}</label>
					<input
						id="contact-name"
						name="name"
						type="text"
						required
						autocomplete="name"
						placeholder={t('contact.form.name.placeholder')}
						aria-describedby="contact-name-error"
						class={fieldClass}
					/>
					<p id="contact-name-error" class="field-error mt-2 text-ui text-accent-ink" hidden></p>
				</div>

				<div>
					<label class="text-ui font-medium" for="contact-email">{t('contact.form.email')}</label>
					<input
						id="contact-email"
						name="email"
						type="email"
						required
						autocomplete="email"
						placeholder={t('contact.form.email.placeholder')}
						aria-describedby="contact-email-error"
						class={fieldClass}
					/>
					<p id="contact-email-error" class="field-error mt-2 text-ui text-accent-ink" hidden></p>
				</div>

				<div>
					<label class="text-ui font-medium" for="contact-message">{t('contact.form.message')}</label>
					<textarea
						id="contact-message"
						name="message"
						required
						rows="5"
						placeholder={t('contact.form.message.placeholder')}
						aria-describedby="contact-message-error"
						class={`${fieldClass} resize-y`}
					></textarea>
					<p id="contact-message-error" class="field-error mt-2 text-ui text-accent-ink" hidden></p>
				</div>

				<div class="flex flex-wrap items-center gap-6">
					<button
						type="submit"
						class="inline-flex items-center gap-3 bg-ink px-7 py-4 text-body font-medium text-paper transition-[background-color,transform,opacity] duration-300 hover:bg-accent hover:text-on-accent active:scale-[0.98] disabled:pointer-events-none disabled:opacity-60"
					>
						<span class="submit-label">{t('contact.form.submit')}</span>
						<span aria-hidden="true">→</span>
					</button>
					<p id="contact-status" class="text-body" role="status" aria-live="polite"></p>
				</div>
			</form>
		</div>
	</div>
</section>

<script>
	// Contact form: inline validation, then an async submit with visible states.
	const form = document.getElementById('contact-form') as HTMLFormElement | null

	if (form) {
		const msg = form.dataset
		const status = document.getElementById('contact-status') as HTMLElement
		const submit = form.querySelector('button[type="submit"]') as HTMLButtonElement
		const submitLabel = form.querySelector('.submit-label') as HTMLElement
		const defaultLabel = submitLabel.textContent
		const fields = Array.from(
			form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input, textarea'),
		)

		const validate = (field: HTMLInputElement | HTMLTextAreaElement) => {
			const error = document.getElementById(`${field.id}-error`) as HTMLElement
			let message = ''
			if (field.validity.valueMissing) message = msg.msgRequired ?? ''
			else if (field.validity.typeMismatch) message = msg.msgEmail ?? ''
			field.setAttribute('aria-invalid', String(Boolean(message)))
			error.textContent = message
			error.hidden = !message
			return !message
		}

		fields.forEach((field) => {
			field.addEventListener('blur', () => {
				if (field.value) validate(field)
			})
			field.addEventListener('input', () => {
				if (field.getAttribute('aria-invalid') === 'true') validate(field)
			})
		})

		form.addEventListener('submit', async (event) => {
			event.preventDefault()
			const invalid = fields.filter((field) => !validate(field))
			if (invalid.length) {
				invalid[0].focus()
				return
			}

			submit.disabled = true
			submitLabel.textContent = msg.msgSending ?? ''
			status.textContent = ''
			status.classList.remove('text-accent-ink')

			try {
				const response = await fetch(form.action, {
					method: 'POST',
					body: new FormData(form),
					headers: { Accept: 'application/json' },
				})
				if (!response.ok) throw new Error(String(response.status))
				form.reset()
				status.textContent = msg.msgSuccess ?? ''
			} catch {
				status.textContent = msg.msgError ?? ''
				status.classList.add('text-accent-ink')
			} finally {
				submit.disabled = false
				submitLabel.textContent = defaultLabel
			}
		})
	}
</script>
