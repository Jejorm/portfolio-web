---
import { languages } from '../i18n/ui'
import { getLangFromUrl, useTranslations } from '../i18n/utils'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

const home = lang === 'en' ? '/' : `/${lang}/`
const links = [
	{ href: '#projects', label: t('nav.work') },
	{ href: '#about', label: t('nav.about') },
	{ href: '#skills', label: t('nav.skills') },
	{ href: '#principles', label: t('nav.principles') },
	{ href: '#contact', label: t('nav.contact') },
]
const locales = Object.keys(languages) as (keyof typeof languages)[]
---

<header
	class="nav-surface fixed inset-x-0 top-0 z-40 border-b border-line bg-paper/85 backdrop-blur-md"
	id="main-nav"
>
	<nav
		class="mx-auto flex h-16 max-w-[1440px] items-center justify-between gap-6 px-4 md:px-8"
		aria-label="Main Navigation"
	>
		<a
			href={home}
			class="flex items-baseline gap-2 text-[15px] font-semibold tracking-tight"
			aria-label={t('nav.home')}
		>
			<span class="inline-block size-2.5 translate-y-[-1px] bg-accent" aria-hidden="true"></span>
			Jeremy Orellana
		</a>

		<ul class="hidden items-center gap-7 text-[15px] lg:flex">
			{
				links.map((link) => (
					<li>
						<a class="link-line text-ink-muted transition-colors hover:text-ink" href={link.href}>
							{link.label}
						</a>
					</li>
				))
			}
		</ul>

		<div class="hidden items-center gap-5 lg:flex">
			<div class="meta flex items-center gap-2" role="group" aria-label={t('nav.language')}>
				{
					locales.map((l, i) => (
						<>
							{i > 0 && <span class="text-line" aria-hidden="true">/</span>}
							<a
								href={l === 'en' ? '/' : `/${l}/`}
								hreflang={l}
								lang={l}
								aria-current={lang === l ? 'true' : undefined}
								class:list={[
									'uppercase transition-colors',
									lang === l ? 'text-ink' : 'text-ink-muted hover:text-ink',
								]}
							>
								{l}
								<span class="sr-only">{languages[l]}</span>
							</a>
						</>
					))
				}
			</div>
			<button
				type="button"
				class="theme-toggle meta flex items-center gap-2 uppercase text-ink-muted transition-colors hover:text-ink"
				aria-pressed="false"
				aria-label={t('nav.theme')}
			>
				<span
					class="theme-swatch inline-block size-2.5 border border-current"
					aria-hidden="true"
				></span>
				{t('nav.theme.dark')}
			</button>
		</div>

		<button
			type="button"
			class="meta border border-line px-3 py-1.5 uppercase lg:hidden"
			id="menu-toggle"
			aria-expanded="false"
			aria-controls="mobile-menu"
			data-open-label={t('nav.menu.open')}
			data-close-label={t('nav.menu.close')}
			aria-label={t('nav.menu.open')}
		>
			{t('nav.menu')}
		</button>
	</nav>

</header>

<!-- Mobile menu: full-height sheet with large type -->
<div
	id="mobile-menu"
	class="fixed inset-x-0 top-16 bottom-0 z-30 flex flex-col justify-between border-t border-line bg-paper px-4 pt-8 pb-10 lg:hidden"
	hidden
>
	<ul class="space-y-1">
		{
			links.map((link) => (
				<li>
					<a class="display block py-1 text-[clamp(2.75rem,13vw,4.5rem)]" href={link.href}>
						{link.label}
					</a>
				</li>
			))
		}
	</ul>
	<div class="meta flex items-center justify-between uppercase">
		<div class="flex items-center gap-3" role="group" aria-label={t('nav.language')}>
			{
				locales.map((l) => (
					<a
						href={l === 'en' ? '/' : `/${l}/`}
						hreflang={l}
						lang={l}
						aria-current={lang === l ? 'true' : undefined}
						class={lang === l ? 'text-ink' : 'text-ink-muted'}
					>
						{languages[l]}
					</a>
				))
			}
		</div>
		<button
			type="button"
			class="theme-toggle flex items-center gap-2 uppercase"
			aria-pressed="false"
			aria-label={t('nav.theme')}
		>
			<span
				class="theme-swatch inline-block size-2.5 border border-current"
				aria-hidden="true"
			></span>
			{t('nav.theme.dark')}
		</button>
	</div>
</div>

<style>
	[aria-pressed='true'] .theme-swatch {
		background-color: currentColor;
	}
</style>

<script>
	const root = document.documentElement
	const systemDark = window.matchMedia('(prefers-color-scheme: dark)')

	const isDark = () =>
		root.dataset.theme ? root.dataset.theme === 'dark' : systemDark.matches

	const syncToggles = () => {
		document.querySelectorAll('.theme-toggle').forEach((button) => {
			button.setAttribute('aria-pressed', String(isDark()))
		})
	}

	document.querySelectorAll('.theme-toggle').forEach((button) => {
		button.addEventListener('click', () => {
			const next = isDark() ? 'light' : 'dark'
			root.dataset.theme = next
			try {
				localStorage.setItem('theme', next)
			} catch {}
			syncToggles()
		})
	})
	systemDark.addEventListener('change', syncToggles)
	syncToggles()

	// Mobile menu
	const toggle = document.getElementById('menu-toggle')
	const menu = document.getElementById('mobile-menu')

	if (toggle && menu) {
		const setOpen = (open: boolean) => {
			menu.hidden = !open
			toggle.setAttribute('aria-expanded', String(open))
			toggle.setAttribute(
				'aria-label',
				(open ? toggle.dataset.closeLabel : toggle.dataset.openLabel) ?? '',
			)
			document.body.style.overflow = open ? 'hidden' : ''
			if (open) menu.querySelector('a')?.focus()
		}

		toggle.addEventListener('click', () => setOpen(menu.hidden))
		menu.querySelectorAll('a[href^="#"]').forEach((link) => {
			link.addEventListener('click', () => setOpen(false))
		})
		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && !menu.hidden) {
				setOpen(false)
				toggle.focus()
			}
		})
		window.matchMedia('(min-width: 1024px)').addEventListener('change', (event) => {
			if (event.matches) setOpen(false)
		})
	}
</script>
