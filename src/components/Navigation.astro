---
import { languages } from '../i18n/ui'
import { getLangFromUrl, useTranslations } from '../i18n/utils'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

const home = lang === 'en' ? '/' : `/${lang}/`
const links = [
	{ href: '#projects', label: t('nav.work') },
	{ href: '#about', label: t('nav.about') },
	{ href: '#skills', label: t('nav.skills') },
	{ href: '#principles', label: t('nav.principles') },
	{ href: '#contact', label: t('nav.contact') },
]
const locales = Object.keys(languages) as (keyof typeof languages)[]
---

<header
	class="nav-surface fixed inset-x-0 top-0 z-40 border-b border-line bg-paper/85 backdrop-blur-md"
	id="main-nav"
>
	<nav
		class="mx-auto flex h-16 max-w-[1440px] items-center justify-between gap-6 px-4 md:px-8"
		aria-label="Main Navigation"
	>
		<a
			href={home}
			class="text-body font-semibold tracking-tight"
			aria-label={t('nav.home')}
		>
			Jeremy Orellana
		</a>

		<ul class="hidden items-center gap-7 text-body lg:flex">
			{
				links.map((link) => (
					<li>
						<a class="link-line text-ink-muted transition-colors hover:text-ink" href={link.href}>
							{link.label}
						</a>
					</li>
				))
			}
		</ul>

		<div class="hidden items-center gap-5 lg:flex">
			<div class="meta flex items-center gap-2" role="group" aria-label={t('nav.language')}>
				{
					locales.map((l, i) => (
						<>
							{i > 0 && <span class="text-line" aria-hidden="true">/</span>}
							<a
								href={l === 'en' ? '/' : `/${l}/`}
								hreflang={l}
								lang={l}
								aria-current={lang === l ? 'true' : undefined}
								class:list={[
									'uppercase transition-colors',
									lang === l ? 'text-ink' : 'text-ink-muted hover:text-ink',
								]}
							>
								{l}
								<span class="sr-only">{languages[l]}</span>
							</a>
						</>
					))
				}
			</div>
			<button
				type="button"
				class="theme-toggle cursor-pointer flex min-h-11 min-w-11 items-center justify-center text-ink-muted transition-colors hover:text-ink"
				aria-pressed="false"
				aria-label={t('nav.theme')}
			>
				<svg class="theme-icon theme-icon-sun size-4 shrink-0" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true" focusable="false"><rect x="5.25" y="5.25" width="5.5" height="5.5"></rect><path d="M8 1v1.5M8 13.5V15M1 8h1.5M13.5 8H15M3 3l1 1M12 12l1 1M3 13l1-1M12 4l1-1"></path></svg>
				<svg class="theme-icon theme-icon-moon size-4 shrink-0" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="miter" aria-hidden="true" focusable="false"><path d="M7 1.75 2.75 6v4L7 14.25h6.5L14.5 12H9.5L7.5 10V6l2-2h5L13.5 1.75Z"></path></svg>
			</button>
		</div>

		<button
			type="button"
			class="meta inline-flex min-h-11 items-center border border-line px-4 text-ui uppercase lg:hidden"
			id="menu-toggle"
			aria-expanded="false"
			aria-controls="mobile-menu"
			data-open-label={t('nav.menu.open')}
			data-close-label={t('nav.menu.close')}
			aria-label={t('nav.menu.open')}
		>
			{t('nav.menu')}
		</button>
	</nav>

</header>

<!-- Mobile menu: full-height sheet with large type -->
<div
	id="mobile-menu"
	class="fixed inset-x-0 top-16 bottom-0 z-30 flex flex-col justify-between border-t border-line bg-paper px-4 pt-8 pb-10 lg:hidden"
	hidden
>
	<ul class="space-y-1">
		{
			links.map((link) => (
				<li>
					<a class="display block py-1 text-display-l" href={link.href}>
						{link.label}
					</a>
				</li>
			))
		}
	</ul>
	<div class="meta flex items-center justify-between uppercase">
		<div class="flex items-center gap-3" role="group" aria-label={t('nav.language')}>
			{
				locales.map((l) => (
					<a
						href={l === 'en' ? '/' : `/${l}/`}
						hreflang={l}
						lang={l}
						aria-current={lang === l ? 'true' : undefined}
						class={lang === l ? 'text-ink' : 'text-ink-muted'}
					>
						{languages[l]}
					</a>
				))
			}
		</div>
		<button
			type="button"
			class="theme-toggle cursor-pointer flex min-h-11 min-w-11 items-center justify-center text-ink-muted transition-colors hover:text-ink"
			aria-pressed="false"
			aria-label={t('nav.theme')}
		>
			<svg class="theme-icon theme-icon-sun size-4 shrink-0" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true" focusable="false"><rect x="5.25" y="5.25" width="5.5" height="5.5"></rect><path d="M8 1v1.5M8 13.5V15M1 8h1.5M13.5 8H15M3 3l1 1M12 12l1 1M3 13l1-1M12 4l1-1"></path></svg>
			<svg class="theme-icon theme-icon-moon size-4 shrink-0" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="miter" aria-hidden="true" focusable="false"><path d="M7 1.75 2.75 6v4L7 14.25h6.5L14.5 12H9.5L7.5 10V6l2-2h5L13.5 1.75Z"></path></svg>
		</button>
	</div>
</div>

<!--
	Theme toggle: inline (not bundled by Vite) so it runs synchronously after both
	toggles exist and cannot be lost to a stale module or HMR state.
	After a choice the resolved theme is explicit on <html>. One delegated
	handler serves both toggles (desktop and mobile sheet).
-->
<script is:inline>
	;(() => {
		const root = document.documentElement
		const systemDark = window.matchMedia('(prefers-color-scheme: dark)')

		const isDark = () =>
			root.dataset.theme === 'dark' ||
			(root.dataset.theme !== 'light' && systemDark.matches)

		const syncToggles = () => {
			const pressed = String(isDark())
			for (const button of document.querySelectorAll('.theme-toggle')) {
				button.setAttribute('aria-pressed', pressed)
			}
		}

		syncToggles()
		if (window.__themeToggleBound) return
		window.__themeToggleBound = true

		document.addEventListener('click', (event) => {
			const target = event.target
			if (!(target instanceof Element) || !target.closest('.theme-toggle')) return
			const next = isDark() ? 'light' : 'dark'
			root.dataset.theme = next
			try {
				localStorage.setItem('theme', next)
			} catch {}
			syncToggles()
		})
		systemDark.addEventListener('change', syncToggles)
		// Back/forward cache restores can carry a theme chosen on another page.
		window.addEventListener('pageshow', () => {
			try {
				const stored = localStorage.getItem('theme')
				if (stored === 'light' || stored === 'dark') root.dataset.theme = stored
			} catch {}
			syncToggles()
		})
	})()
</script>

<script>
	// Mobile menu
	const toggle = document.getElementById('menu-toggle')
	const menu = document.getElementById('mobile-menu')

	if (toggle && menu) {
		const setOpen = (open: boolean) => {
			menu.hidden = !open
			toggle.setAttribute('aria-expanded', String(open))
			toggle.setAttribute(
				'aria-label',
				(open ? toggle.dataset.closeLabel : toggle.dataset.openLabel) ?? '',
			)
			document.body.style.overflow = open ? 'hidden' : ''
			if (open) menu.querySelector('a')?.focus()
		}

		toggle.addEventListener('click', () => setOpen(menu.hidden))
		menu.querySelectorAll('a[href^="#"]').forEach((link) => {
			link.addEventListener('click', () => setOpen(false))
		})
		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && !menu.hidden) {
				setOpen(false)
				toggle.focus()
			}
		})
		window.matchMedia('(min-width: 1024px)').addEventListener('change', (event) => {
			if (event.matches) setOpen(false)
		})
	}
</script>
