---
import { Image } from 'astro:assets'
import { getCollection } from 'astro:content'
import { getLangFromUrl, useTranslations } from '../i18n/utils'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

const projects = (
	await getCollection('projects', ({ id }) => id.startsWith(`${lang}/`))
)
	.sort((a, b) => a.data.order - b.data.order)
	.map((entry) => ({
		...entry.data,
		slug: entry.id.split('/').pop() as string,
		index: String(entry.data.order).padStart(2, '0'),
		// Pairs beyond the first fold into a native <details>
		extra:
			Math.max(entry.data.challenges.length, entry.data.solutions.length) - 1,
	}))

const pad = (n: number) => String(n + 1).padStart(2, '0')
const moreLabel = (count: number) =>
	t(count === 1 ? 'work.more.one' : 'work.more.other').replace(
		'{n}',
		String(count),
	)
---

<section id="projects" class="border-t border-line" aria-labelledby="projects-heading">
	<div
		class="mx-auto grid max-w-[1440px] grid-cols-1 gap-12 px-4 py-24 md:px-8 md:py-32 lg:grid-cols-12 lg:gap-8"
	>
		<!-- Sticky index: title, intro and a live table of contents -->
		<div class="lg:col-span-4">
			<div class="lg:sticky lg:top-28">
				<h2 id="projects-heading" class="display text-display-l" data-reveal>
					{t('work.title')}
				</h2>
				<p class="mt-6 max-w-[32ch] text-lead text-ink-muted" data-reveal style="--d: 1">
					{t('work.intro')}
				</p>

				<nav class="mt-14 hidden lg:block" aria-label={t('work.index')}>
					<ol class="border-t border-line">
						{
							projects.map((project) => (
								<li class="border-b border-line">
									<a
										href={`#${project.slug}`}
										class="project-index-link group grid grid-cols-[3rem_1fr] items-baseline gap-2 py-4 text-ink-muted transition-colors hover:text-ink"
										data-target={project.slug}
									>
										<span class="meta">{project.index}</span>
										<span>
											<span class="block text-lead font-semibold tracking-tight">
												{project.title}
											</span>
											<span class="meta mt-1 block">{project.kind}</span>
										</span>
									</a>
								</li>
							))
						}
					</ol>
				</nav>
			</div>
		</div>

		<!-- Case studies -->
		<div class="space-y-28 md:space-y-40 lg:col-span-8">
			{
				projects.map((project, i) => (
					<article id={project.slug} class="project group scroll-mt-24" aria-labelledby={`${project.slug}-title`}>
						<figure class="overflow-clip bg-raised">
							<div class="clip-reveal aspect-[16/10]">
								<Image
									src={project.image}
									alt={project.imageAlt}
									widths={[720, 1280, 1920, 2560]}
									sizes="(min-width: 1024px) 60vw, 100vw"
									quality="high"
									loading={i === 0 ? 'eager' : 'lazy'}
									class="h-full w-full object-cover object-center transition-transform duration-[1.2s] ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-[1.03]"
								/>
							</div>
						</figure>

						<header class="mt-8">
							<h3 id={`${project.slug}-title`} class="display text-display-s">
								{project.title}
							</h3>
							<p class="mt-5 max-w-[46ch] text-lead leading-snug">{project.summary}</p>
						</header>

						<!-- The live site is the primary action of each case study: full width on
						     phones, accent at rest so it reads before hover. -->
						<div class="mt-8 flex flex-col gap-5 sm:flex-row sm:flex-wrap sm:items-center sm:gap-x-8">
							<a
								class="live-link inline-flex min-h-14 items-center justify-between gap-6 bg-accent px-7 py-4 text-lead font-semibold text-on-accent transition-[background-color,color,transform] duration-300 hover:bg-ink hover:text-paper active:scale-[0.98] sm:justify-start"
								href={project.liveUrl}
								target="_blank"
								rel="noopener noreferrer"
								aria-label={`${t('work.live')}: ${project.title}`}
							>
								{t('work.live')}
								<span class="arrow-nudge" aria-hidden="true">↗</span>
							</a>
							{project.links.map((link) => (
								<a
									class="link-line inline-flex items-center gap-2 self-start text-body text-ink-muted hover:text-ink sm:self-auto"
									href={link.url}
									target="_blank"
									rel="noopener noreferrer"
									aria-label={`${link.label}: ${project.title}`}
								>
									{link.label}
									<span class="arrow-nudge" aria-hidden="true">↗</span>
								</a>
							))}
						</div>

						<p class="mt-8 max-w-[62ch] text-body text-ink-muted">{project.description}</p>

						<div class="mt-10 border-t border-line pt-8">
							<div class="grid grid-cols-1 gap-10 md:grid-cols-2 md:gap-8">
								<div>
									<h4 class="text-ui font-semibold">{t('work.challenges')}</h4>
									<ol class="mt-4 space-y-4">
										{project.challenges.slice(0, 1).map((item, n) => (
											<li class="grid grid-cols-[2rem_1fr] text-body text-ink-muted">
												<span class="meta pt-1 text-ink">{pad(n)}</span>
												<span>{item}</span>
											</li>
										))}
									</ol>
								</div>
								<div>
									<h4 class="text-ui font-semibold">{t('work.solutions')}</h4>
									<ol class="mt-4 space-y-4">
										{project.solutions.slice(0, 1).map((item, n) => (
											<li class="grid grid-cols-[2rem_1fr] text-body text-ink-muted">
												<span class="meta pt-1 text-accent-ink">{pad(n)}</span>
												<span>{item}</span>
											</li>
										))}
									</ol>
								</div>
							</div>

							{project.extra > 0 && (
								<details class="more mt-10">
									<summary class="more-summary flex min-h-11 cursor-pointer items-center justify-between gap-4 border border-line px-4 py-2 text-body font-medium text-ink transition-colors hover:bg-raised">
										<span class="more-label-closed">{moreLabel(project.extra)}</span>
										<span class="more-label-open">{t('work.less')}</span>
										<span class="more-icon" aria-hidden="true" />
									</summary>
									<div class="more-body">
										<div class="more-content grid grid-cols-1 gap-10 pt-8 md:grid-cols-2 md:gap-8">
											<div>
												<h4 class="sr-only">{t('work.challenges')}</h4>
												<ol class="space-y-4">
													{project.challenges.slice(1).map((item, n) => (
														<li class="grid grid-cols-[2rem_1fr] text-body text-ink-muted">
															<span class="meta pt-1 text-ink">{pad(n + 1)}</span>
															<span>{item}</span>
														</li>
													))}
												</ol>
											</div>
											<div>
												<h4 class="sr-only">{t('work.solutions')}</h4>
												<ol class="space-y-4">
													{project.solutions.slice(1).map((item, n) => (
														<li class="grid grid-cols-[2rem_1fr] text-body text-ink-muted">
															<span class="meta pt-1 text-accent-ink">{pad(n + 1)}</span>
															<span>{item}</span>
														</li>
													))}
												</ol>
											</div>
										</div>
									</div>
								</details>
							)}
						</div>

						<div class="mt-10 flex flex-wrap items-baseline gap-x-5 gap-y-2">
							<h4 class="meta text-ink-muted">{t('work.stack')}</h4>
							<ul class="meta text-ui flex flex-wrap gap-x-5 gap-y-2">
								{project.tags.map((tag) => (
									<li>{tag}</li>
								))}
							</ul>
						</div>
					</article>
				))
			}
		</div>
	</div>
</section>

<style>
	/* Native disclosure, enhanced by the script below to ease open and closed.
	   The +/- icon changes shape, not just color, so state never relies on
	   color alone. */
	.more-summary {
		list-style: none;
	}

	.more-summary::-webkit-details-marker {
		display: none;
	}

	.more-summary::marker {
		content: '';
	}

	.more-icon {
		position: relative;
		flex: none;
		width: 0.875rem;
		height: 0.875rem;
	}

	.more-icon::before,
	.more-icon::after {
		content: '';
		position: absolute;
		background-color: currentColor;
	}

	.more-icon::before {
		inset: calc(50% - 1px) 0;
	}

	.more-icon::after {
		inset: 0 calc(50% - 1px);
	}

	/* .is-closing flips the label and icon as soon as closing starts, while
	   [open] stays set until the height animation ends. */
	.more[open]:not(.is-closing) .more-icon::after,
	.more:not([open]) .more-label-open,
	.more.is-closing .more-label-open,
	.more[open]:not(.is-closing) .more-label-closed {
		display: none;
	}

	.more-body {
		overflow: clip;
	}

	.project-index-link[aria-current='true'] {
		color: var(--ink);
	}

	.project-index-link[aria-current='true'] .meta:first-child {
		color: var(--accent-ink);
	}
</style>

<script>
	// Ease the problems/solutions disclosure open and closed: height eases while
	// the content fades and rises a few pixels. Without JS or with reduced motion
	// the native <details> toggles instantly.
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)')
	const ease = 'cubic-bezier(0.16, 1, 0.3, 1)'

	document.querySelectorAll<HTMLDetailsElement>('details.more').forEach((details) => {
		const summary = details.querySelector('summary')
		const body = details.querySelector<HTMLElement>('.more-body')
		const content = details.querySelector<HTMLElement>('.more-content')
		if (!summary || !body || !content) return

		let height: Animation | undefined
		let fade: Animation | undefined

		summary.addEventListener('click', (event) => {
			if (reduceMotion.matches) return
			event.preventDefault()

			const from = `${body.offsetHeight}px`
			height?.cancel()
			fade?.cancel()

			const closing = details.open && !details.classList.contains('is-closing')
			if (closing) {
				details.classList.add('is-closing')
				height = body.animate({ height: [from, '0px'] }, { duration: 380, easing: ease })
				fade = content.animate(
					{ opacity: [1, 0], transform: ['none', 'translateY(-6px)'] },
					{ duration: 200, easing: 'ease-in', fill: 'forwards' },
				)
				height.onfinish = () => {
					details.open = false
					details.classList.remove('is-closing')
					fade?.cancel()
				}
				return
			}

			details.classList.remove('is-closing')
			details.open = true
			height = body.animate(
				{ height: [from, `${content.offsetHeight}px`] },
				{ duration: 480, easing: ease },
			)
			fade = content.animate(
				{ opacity: [0, 1], transform: ['translateY(10px)', 'none'] },
				{ duration: 520, delay: 90, easing: ease, fill: 'backwards' },
			)
		})
	})

	// Highlight the case study currently crossing the middle of the viewport.
	const links = document.querySelectorAll<HTMLAnchorElement>('.project-index-link')

	if (links.length) {
		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (!entry.isIntersecting) continue
					links.forEach((link) => {
						if (link.dataset.target === entry.target.id) {
							link.setAttribute('aria-current', 'true')
						} else {
							link.removeAttribute('aria-current')
						}
					})
				}
			},
			{ rootMargin: '-45% 0px -50% 0px' },
		)

		document.querySelectorAll('article.project').forEach((article) => {
			observer.observe(article)
		})
	}
</script>
