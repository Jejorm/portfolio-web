---
import { Image } from 'astro:assets'
import portrait from '../assets/images/hero-image.webp'
import { getLangFromUrl, useTranslations } from '../i18n/utils'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

const name = 'Jeremy Orellana'
const words = name.split(' ')
---

<section
	id="top"
	class="relative flex min-h-[100dvh] flex-col justify-between overflow-clip pt-24 pb-3 md:pb-5"
	aria-labelledby="hero-heading"
>
	<div
		class="mx-auto grid w-full max-w-[1440px] grid-cols-1 gap-10 px-4 md:grid-cols-12 md:items-stretch md:gap-8 md:px-8"
	>
		<div class="flex flex-col justify-between gap-12 md:col-span-7 lg:col-span-8">
			<p class="meta flex items-start gap-3 text-ui text-ink-muted">
				<span class="lamp mt-[0.3em] shrink-0" aria-hidden="true"></span>
				{t('hero.available')}
			</p>

			<div>
				<p
					id="hero-statement"
					class="line-mask max-w-[22ch] text-display-s leading-[1.08] font-medium tracking-[-0.02em] lg:text-display-m lg:leading-[1.04]"
					style="--d: 1"
				>
					<span>{t('hero.statement')}</span>
				</p>

				<div
					class="mt-10 flex flex-col items-stretch gap-2 sm:flex-row sm:items-center sm:gap-8"
					data-reveal
					style="--d: 3"
				>
					<a
						href="#contact"
						class="group inline-flex min-h-14 w-full items-center justify-center gap-4 bg-ink px-8 text-lead font-medium text-paper transition-[background-color,transform] duration-300 hover:bg-accent hover:text-on-accent active:scale-[0.98] sm:w-auto"
					>
						{t('hero.cta.contact')}
						<span class="transition-transform duration-300 group-hover:translate-y-0.5" aria-hidden="true">↓</span>
					</a>

					<a
						href="#projects"
						class="inline-flex min-h-12 w-full items-center justify-center text-body font-medium text-ink underline decoration-ink-muted decoration-1 underline-offset-[7px] transition-[text-decoration-color] duration-300 hover:decoration-ink sm:w-auto"
					>
						{t('hero.cta.projects')}
					</a>
				</div>
			</div>
		</div>

		<figure class="w-full md:col-span-5 lg:col-span-4" data-reveal style="--d: 2">
			<div class="aspect-square overflow-hidden bg-raised sm:aspect-[4/3] md:aspect-[3/4]">
				<Image
					src={portrait}
					alt={t('hero.portrait.alt')}
					widths={[480, 720, 810]}
					sizes="(min-width: 1024px) 30vw, (min-width: 768px) 40vw, 100vw"
					loading="eager"
					fetchpriority="high"
					class="portrait-drift h-full w-full object-cover object-top grayscale-[35%] transition-[filter] duration-700 hover:grayscale-0"
				/>
			</div>
		</figure>
	</div>

	<!-- Name as the hero's visual anchor. Words are wrapped so mobile can give each
	     its own line while the name condenses on scroll. -->
	<h1
		id="hero-heading"
		class="wordmark wordmark-kinetic line-mask mt-12 px-3 leading-[0.84] whitespace-normal md:px-6 md:text-[10.4vw] md:leading-[0.8] md:whitespace-nowrap"
		style="--d: 0"
	>
		<span>
			{words.map((word, index) => (
				<>
					{index > 0 && ' '}
					<span class="word">{word}</span>
				</>
			))}
		</span>
	</h1>
</section>

