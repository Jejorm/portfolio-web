---
import { Image } from 'astro:assets'
import portrait from '../assets/images/hero-image.webp'
import { getLangFromUrl, useTranslations } from '../i18n/utils'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

const name = 'Jeremy Orellana'
const words = name.split(' ')
---

<section
	id="top"
	class="relative flex min-h-[100dvh] flex-col justify-between overflow-clip pt-24 pb-3 md:pb-5"
	aria-labelledby="hero-heading"
>
	<div
		class="mx-auto grid w-full max-w-[1440px] grid-cols-1 gap-10 px-4 md:grid-cols-12 md:gap-8 md:px-8"
	>
		<div class="flex flex-col justify-between gap-12 md:col-span-7 lg:col-span-6">
			<p class="meta flex items-start gap-3 text-ink-muted">
				<span class="lamp mt-[0.3em] shrink-0" aria-hidden="true"></span>
				{t('hero.available')}
			</p>

			<div>
				<p
					id="hero-statement"
					class="line-mask max-w-[22ch] text-[clamp(1.75rem,3.4vw,3rem)] leading-[1.08] font-medium tracking-[-0.02em]"
					style="--d: 1"
				>
					<span>{t('hero.statement')}</span>
				</p>

				<div
					class="mt-10 flex flex-col items-stretch gap-3 sm:flex-row sm:items-center"
					data-reveal
					style="--d: 3"
				>
					<a
						href="#contact"
						class="group inline-flex min-h-12 w-full items-center justify-center gap-3 bg-ink px-6 text-[15px] font-medium text-paper transition-[background-color,transform] duration-300 hover:bg-accent hover:text-on-accent active:scale-[0.98] sm:w-auto"
					>
						{t('hero.cta.contact')}
						<span class="transition-transform duration-300 group-hover:translate-y-0.5" aria-hidden="true">↓</span>
					</a>

					<a
						href="#projects"
						class="inline-flex min-h-12 w-full items-center justify-center border border-ink px-6 text-[15px] font-medium text-ink transition-[background-color,transform] duration-300 hover:bg-raised active:scale-[0.98] sm:w-auto"
					>
						{t('hero.cta.projects')}
					</a>
				</div>
			</div>
		</div>

		<figure class="w-full md:col-span-4 md:col-start-9 lg:col-span-3 lg:col-start-10" data-reveal style="--d: 2">
			<div class="aspect-square overflow-hidden bg-raised sm:aspect-[4/3] md:aspect-[4/5]">
				<Image
					src={portrait}
					alt={t('hero.portrait.alt')}
					widths={[320, 480, 720, 810]}
					sizes="(min-width: 1024px) 22vw, (min-width: 768px) 30vw, 100vw"
					loading="eager"
					fetchpriority="high"
					class="h-full w-full object-cover object-top grayscale-[35%] transition-[filter] duration-700 hover:grayscale-0 md:object-center"
				/>
			</div>
		</figure>
	</div>

	<!-- Name as the hero's visual anchor. Letters are split at build time for the
	     hover response; aria-label carries the name for assistive tech. -->
	<h1
		id="hero-heading"
		aria-label={name}
		class="wordmark wordmark-kinetic line-mask mt-12 px-3 text-[20vw] leading-[0.84] whitespace-normal md:px-6 md:text-[10.4vw] md:leading-[0.8] md:whitespace-nowrap"
		style="--d: 0"
	>
		<span aria-hidden="true">
			{words.map((word, index) => (
				<>
					{index > 0 && ' '}
					<span class="word">{[...word].map((char) => <span class="l">{char}</span>)}</span>
				</>
			))}
		</span>
	</h1>
</section>
