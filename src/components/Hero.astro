---
import { Image } from 'astro:assets'
import portrait from '../assets/images/hero-image.webp'
import { getLangFromUrl, useTranslations } from '../i18n/utils'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
---

<section
	id="top"
	class="relative flex min-h-[100dvh] flex-col justify-between overflow-hidden pt-24 pb-3 md:pb-5"
	aria-labelledby="hero-heading"
>
	<div
		class="mx-auto grid w-full max-w-[1440px] grid-cols-1 gap-10 px-4 md:grid-cols-12 md:gap-8 md:px-8"
	>
		<div class="flex flex-col justify-between gap-12 md:col-span-7 lg:col-span-6">
			<p class="meta flex items-start gap-3 text-ink-muted">
				<span class="mt-[0.3em] inline-block size-2 shrink-0 bg-accent" aria-hidden="true"></span>
				{t('hero.available')}
			</p>

			<div>
				<p
					id="hero-statement"
					class="line-mask max-w-[22ch] text-[clamp(1.75rem,3.4vw,3rem)] leading-[1.08] font-medium tracking-[-0.02em]"
					style="--d: 1"
				>
					<span>{t('hero.statement')}</span>
				</p>

				<div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-4" data-reveal style="--d: 3">
					<a
						href="#projects"
						class="group inline-flex items-center gap-3 bg-ink px-6 py-3.5 text-[15px] font-medium text-paper transition-[background-color,transform] duration-300 hover:bg-accent hover:text-on-accent active:scale-[0.98]"
					>
						{t('hero.cta')}
						<span class="transition-transform duration-300 group-hover:translate-y-0.5" aria-hidden="true">↓</span>
					</a>
					<a href="mailto:jejorm8@gmail.com" class="link-line text-[15px] text-ink-muted hover:text-ink">
						jejorm8@gmail.com
					</a>
				</div>
			</div>
		</div>

		<figure class="w-3/5 sm:w-1/2 md:w-auto md:col-span-4 md:col-start-9 lg:col-span-3 lg:col-start-10" data-reveal style="--d: 2">
			<div class="aspect-[4/5] overflow-hidden bg-raised">
				<Image
					src={portrait}
					alt={t('hero.portrait.alt')}
					widths={[320, 480, 720]}
					sizes="(min-width: 1024px) 22vw, (min-width: 768px) 30vw, 90vw"
					loading="eager"
					fetchpriority="high"
					class="h-full w-full object-cover grayscale-[35%] transition-[filter] duration-700 hover:grayscale-0"
				/>
			</div>
		</figure>
	</div>

	<!-- Name as the hero's visual anchor; condenses on scroll where supported -->
	<h1
		id="hero-heading"
		class="wordmark wordmark-kinetic line-mask mt-12 px-3 text-[20vw] leading-[0.84] whitespace-normal md:px-6 md:text-[10.4vw] md:leading-[0.8] md:whitespace-nowrap"
		style="--d: 0"
	>
		<span>Jeremy Orellana</span>
	</h1>
</section>
