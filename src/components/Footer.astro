---
import { getLangFromUrl, useTranslations } from '../i18n/utils'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

const currentYear = new Date().getFullYear()
---

<footer class="border-t border-line" aria-label="Site Footer">
	<div
		class="meta mx-auto flex max-w-[1440px] flex-col gap-6 px-4 py-10 text-ink-muted md:flex-row md:items-center md:justify-between md:px-8"
	>
		<p>© {currentYear} {t('footer.rights')}</p>
		<ul class="flex gap-6">
			<li>
				<a class="link-line hover:text-ink" href="https://github.com/Jejorm" target="_blank" rel="noopener noreferrer">
					GitHub
				</a>
			</li>
			<li>
				<a
					class="link-line hover:text-ink"
					href="https://www.linkedin.com/in/jeremy-orellana-76224023a/"
					target="_blank"
					rel="noopener noreferrer"
				>
					LinkedIn
				</a>
			</li>
			<li>
				<a class="link-line hover:text-ink" href="#top">{t('footer.top')} ↑</a>
			</li>
		</ul>
	</div>
</footer>
