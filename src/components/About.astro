---
import { getLangFromUrl, useTranslations } from '../i18n/utils'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

// Split the statement into words so each can ink in as it is read.
const words = t('about.statement').split(' ')
const lastIndex = Math.max(words.length - 1, 1)

const facts = [
	{ label: t('about.fact.base.label'), value: t('about.fact.base.value') },
	{ label: t('about.fact.focus.label'), value: t('about.fact.focus.value') },
	{ label: t('about.fact.work.label'), value: t('about.fact.work.value') },
]

const areas = [1, 2, 3, 4].map((n) => ({
	title: t(`about.area${n}.title` as 'about.area1.title'),
	body: t(`about.area${n}.body` as 'about.area1.body'),
}))
---

<section id="about" class="border-t border-line" aria-labelledby="about-heading">
	<div
		class="mx-auto grid max-w-[1440px] grid-cols-1 gap-12 px-4 py-24 md:px-8 md:py-32 lg:grid-cols-12 lg:gap-8"
	>
		<div class="lg:col-span-3">
			<h2 id="about-heading" class="display text-display-l" data-reveal>
				{t('about.title')}
			</h2>
			<dl class="mt-10 grid grid-cols-1 gap-5 sm:grid-cols-3 lg:grid-cols-1" data-reveal style="--d: 1">
				{
					facts.map((fact) => (
						<div class="border-t border-line pt-3">
							<dt class="meta text-ink-muted">{fact.label}</dt>
							<dd class="mt-1 font-medium">{fact.value}</dd>
						</div>
					))
				}
			</dl>
		</div>

		<div class="lg:col-span-8 lg:col-start-5">
			<p
				class="read-along text-display-s leading-[1.14] font-medium tracking-[-0.02em]"
			>
				{
					words.map((word, i) => (
						<>
							<span class="w" style={`--p: ${(i / lastIndex).toFixed(3)}`}>
								{word}
							</span>{' '}
						</>
					))
				}
			</p>
			<p class="mt-10 max-w-[58ch] text-lead leading-relaxed text-ink-muted" data-reveal>
				{t('about.body')}
			</p>

			<ul class="mt-16 grid grid-cols-1 gap-x-8 gap-y-10 sm:grid-cols-2">
				{
					areas.map((area, i) => (
						<li class="border-t border-ink pt-4" data-reveal style={`--d: ${i}`}>
							<h3 class="text-lead font-semibold tracking-tight">{area.title}</h3>
							<p class="mt-2 max-w-[40ch] leading-relaxed text-ink-muted">{area.body}</p>
						</li>
					))
				}
			</ul>
		</div>
	</div>
</section>
