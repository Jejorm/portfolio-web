---
import { getLangFromUrl, useTranslations } from '../i18n/utils'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

const groups = [
	{
		title: t('skills.col1'),
		items: [
			'React 19',
			'Next.js 16',
			'Astro',
			'TypeScript',
			'Tailwind CSS 4',
			'Radix UI',
		],
	},
	{
		title: t('skills.col2'),
		items: [
			'Node.js',
			'Bun',
			'PostgreSQL',
			'Supabase',
			'Turso (libSQL)',
			'Drizzle ORM',
			'WebSockets',
		],
	},
	{
		title: t('skills.col3'),
		items: ['Docker', 'Vitest', 'Playwright', 'Zod', 'Biome', 'Cloudflare R2'],
	},
]
---

<section id="skills" class="border-t border-line" aria-labelledby="skills-heading">
	<div class="mx-auto max-w-[1440px] px-4 py-24 md:px-8 md:py-32">
		<div class="flex flex-col gap-4">
			<h2 id="skills-heading" class="display text-display-l" data-reveal>
				{t('skills.title')}
			</h2>
			<p class="max-w-[40ch] text-lead text-ink-muted" data-reveal style="--d: 1">
				{t('skills.intro')}
			</p>
		</div>

		<dl class="mt-16">
			{
				groups.map((group, i) => (
					<div
						class="grid grid-cols-1 gap-4 border-t border-line py-8 lg:grid-cols-12 lg:gap-8"
						data-reveal
						style={`--d: ${i}`}
					>
						<dt class="meta pt-2 text-ink-muted lg:col-span-3">{group.title}</dt>
						<dd class="lg:col-span-9">
							<ul class="display flex flex-wrap gap-x-[0.35em] text-display-m leading-[1.02]">
								{group.items.map((item, n) => (
									<li class="stack-item">
										<span class="transition-colors duration-300 hover:text-accent-ink">{item}</span>
										{n < group.items.length - 1 && (
											<span class="text-ink-muted/70" aria-hidden="true">/</span>
										)}
									</li>
								))}
							</ul>
						</dd>
					</div>
				))
			}
		</dl>
	</div>
</section>
