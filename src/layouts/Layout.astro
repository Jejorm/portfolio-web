---
import { getLangFromUrl, useTranslations } from '../i18n/utils'
import '../styles/global.css'

// Local fonts: Archivo with width + weight axes, JetBrains Mono for metadata
import '@fontsource-variable/archivo/wdth.css'
import '@fontsource-variable/jetbrains-mono'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

interface Props {
	title?: string
	description?: string
	noindex?: boolean
}

const {
	title = t('seo.title'),
	description = t('seo.description'),
	noindex = false,
} = Astro.props

const site = Astro.site ?? new URL('https://jeremyo.dev')
const canonicalURL = new URL(Astro.url.pathname, site)
const ogImage = new URL('/og-image.png', site)
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />

		<!-- Theme: stored choice, else system preference. Runs before paint. -->
		<script is:inline>
			;(() => {
				const root = document.documentElement
				root.classList.add('js')
				try {
					const stored = localStorage.getItem('theme')
					if (stored === 'light' || stored === 'dark') root.dataset.theme = stored
				} catch {}
			})()
		</script>

		<title>{title}</title>
		<meta name="title" content={title} />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		{noindex && <meta name="robots" content="noindex" />}
		<link rel="canonical" href={canonicalURL} />
		<meta name="theme-color" content="#ececea" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#0e0e0f" media="(prefers-color-scheme: dark)" />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={canonicalURL} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={ogImage} />

		<!-- I18n -->
		<link rel="alternate" hreflang="en" href={new URL('/', site)} />
		<link rel="alternate" hreflang="es" href={new URL('/es/', site)} />
		<link rel="alternate" hreflang="x-default" href={new URL('/', site)} />

		<!-- Favicons -->
		<link rel="icon" type="image/svg+xml" href="/logo.svg?v=2" />
		<link rel="apple-touch-icon" href="/logo.svg?v=2" />
	</head>
	<body class="min-h-[100dvh] overflow-x-clip antialiased">
		<a
			href="#main"
			class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:bg-accent focus:px-4 focus:py-2 focus:text-on-accent"
		>
			{t('skip.link')}
		</a>
		<slot />

		<!-- Announces the result of any "copy email" button -->
		<p id="copy-status" class="sr-only" role="status" aria-live="polite"></p>

		<script>
			import Lenis from 'lenis'

			const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches

			// Inertial scroll only when motion is welcome; native scroll otherwise.
			const lenis = reduceMotion
				? null
				: new Lenis({
						autoRaf: true,
						duration: 1.1,
						easing: (t: number) => Math.min(1, 1.001 - 2 ** (-10 * t)),
					})

			document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((anchor) => {
				anchor.addEventListener('click', (event) => {
					const hash = anchor.getAttribute('href')
					if (!hash || hash === '#') return
					const target = document.querySelector<HTMLElement>(hash)
					if (!target) return
					event.preventDefault()
					if (lenis) {
						lenis.scrollTo(target, { offset: hash === '#top' ? 0 : -64 })
					} else {
						target.scrollIntoView()
					}
					history.pushState(null, '', hash)
					if (hash !== '#top') {
						target.setAttribute('tabindex', '-1')
						target.focus({ preventScroll: true })
					}
				})
			})

			// Copy email: one handler for every [data-copy-email] button (hero and contact).
			// The button label swaps briefly and a single live region announces the result.
			const copyStatus = document.getElementById('copy-status')
			document.querySelectorAll<HTMLButtonElement>('[data-copy-email]').forEach((button) => {
				let timer: number | undefined
				button.addEventListener('click', async () => {
					const { email = '', copied = '' } = button.dataset
					const original = button.dataset.label ?? button.textContent ?? ''
					button.dataset.label = original
					try {
						await navigator.clipboard.writeText(email)
					} catch {
						window.location.href = `mailto:${email}`
						return
					}
					button.textContent = copied
					if (copyStatus) copyStatus.textContent = ''
					// Set the text on the next frame so repeated copies are announced again.
					requestAnimationFrame(() => {
						if (copyStatus) copyStatus.textContent = copied
					})
					window.clearTimeout(timer)
					timer = window.setTimeout(() => {
						button.textContent = original
						if (copyStatus) copyStatus.textContent = ''
					}, 2000)
				})
			})

			// Entry reveals: one observer, elements unobserved after their first reveal.
			const revealObserver = new IntersectionObserver(
				(entries) => {
					for (const entry of entries) {
						if (!entry.isIntersecting) continue
						entry.target.classList.add('is-in')
						revealObserver.unobserve(entry.target)
					}
				},
				{ rootMargin: '0px 0px -12% 0px' },
			)

			document.querySelectorAll('[data-reveal]').forEach((el) => {
				revealObserver.observe(el)
			})
		</script>
	</body>
</html>
